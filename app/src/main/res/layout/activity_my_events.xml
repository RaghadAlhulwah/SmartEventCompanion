<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/myEventsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F5FC">

    <LinearLayout
        android:id="@+id/footerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:padding="12dp"
        android:background="#F7F5FC">

        <Button
            android:id="@+id/btnHome"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#E7E0F2"
            android:text="Home"
            android:textAllCaps="false"
            android:textColor="#5F4A7E"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnMyEvents"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:backgroundTint="#7656A8"
            android:text="My Events"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/footerLayout"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="18dp">

            <Button
                android:id="@+id/btnBack"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginBottom="12dp"
                android:backgroundTint="#E7E0F2"
                android:text="‹  Back"
                android:textAllCaps="false"
                android:textColor="#5F4A7E" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Events"
                android:textColor="#29243A"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="14dp"
                android:text="Your registered events, all in one place."
                android:textColor="#777184"
                android:textSize="14sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <Button
                    android:id="@+id/btnSaveSummary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginEnd="5dp"
                    android:backgroundTint="#7656A8"
                    android:text="Save Summary"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF" />

                <Button
                    android:id="@+id/btnViewSummary"
                    android:layout_width="0dp"
                    android:layout_height="46dp"
                    android:layout_weight="1"
                    android:layout_marginStart="5dp"
                    android:backgroundTint="#E7E0F2"
                    android:text="View Summary"
                    android:textAllCaps="false"
                    android:textColor="#5F4A7E" />
            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="18dp"
                app:cardElevation="2dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <ScrollView
                        android:id="@+id/emptyState"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:fillViewport="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:gravity="center"
                            android:padding="24dp">

                            <TextView
                                android:id="@+id/tvEmptyMessage"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Loading your events..."
                                android:textColor="#777184"
                                android:textSize="15sp"
                                android:lineSpacingExtra="5dp" />

                            <Button
                                android:id="@+id/btnBrowseEvents"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="18dp"
                                android:backgroundTint="#7656A8"
                                android:text="Browse Events"
                                android:textAllCaps="false"
                                android:textColor="#FFFFFF"
                                android:visibility="gone" />

                            <Button
                                android:id="@+id/btnRetry"
                                android:layout_width="match_parent"
                                android:layout_height="48dp"
                                android:layout_marginTop="10dp"
                                android:backgroundTint="#E7E0F2"
                                android:text="Retry"
                                android:textAllCaps="false"
                                android:textColor="#5F4A7E"
                                android:visibility="gone" />
                        </LinearLayout>
                    </ScrollView>

                    <ListView
                        android:id="@+id/lvMyEvents"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="10dp"
                        android:divider="#EEEAF3"
                        android:dividerHeight="8dp"
                        android:visibility="gone" />
                </FrameLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </ScrollView>
</RelativeLayout>
